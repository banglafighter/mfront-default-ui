{
  "name": "mfront-default-ui",
  "version": "0.0.5-alpha.53",
  "description": "mFront UI Default Implementation",
  "scripts": {
    "build": "tsdown && node scripts/copy-css.js",
    "version:alpha": "pnpm version prerelease --preid alpha --no-git-tag-version --no-git-checks",
    "version:beta": "pnpm version prerelease --preid beta --no-git-tag-version --no-git-checks",
    "version:release": "pnpm version patch --no-git-tag-version --no-git-checks",
    "publish:alpha": "pnpm publish --tag alpha --no-git-checks",
    "publish:beta": "pnpm publish --tag beta --no-git-checks",
    "publish:release": "pnpm publish --tag latest --no-git-checks",
    "release:alpha": "pnpm run build && pnpm run version:alpha && pnpm run publish:alpha",
    "release:beta": "pnpm run build && pnpm run version:beta && pnpm run publish:beta",
    "release": "pnpm run build && pnpm run version:release && pnpm run publish:release"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@base-ui/utils": "^0.2.8",
    "@date-fns/tz": "^1.4.1",
    "@floating-ui/core": "^1.7.5",
    "@floating-ui/dom": "^1.7.6",
    "@floating-ui/react-dom": "^2.1.8",
    "@floating-ui/utils": "^0.2.11",
    "@radix-ui/primitive": "^1.1.3",
    "@radix-ui/react-arrow": "^1.1.8",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-collection": "^1.1.8",
    "@radix-ui/react-compose-refs": "*",
    "@radix-ui/react-context": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dismissable-layer": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-focus-guards": "^1.1.3",
    "@radix-ui/react-focus-scope": "^1.1.8",
    "@radix-ui/react-id": "^1.1.1",
    "@radix-ui/react-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-popper": "^1.2.8",
    "@radix-ui/react-portal": "^1.1.10",
    "@radix-ui/react-presence": "^1.1.5",
    "@radix-ui/react-primitive": "^2.1.4",
    "@radix-ui/react-roving-focus": "^1.1.11",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-use-callback-ref": "^1.1.1",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@radix-ui/react-use-effect-event": "^0.0.2",
    "@radix-ui/react-use-escape-keydown": "^1.1.1",
    "@radix-ui/react-use-layout-effect": "^1.1.1",
    "@radix-ui/react-use-previous": "^1.1.1",
    "@radix-ui/react-use-size": "^1.1.1",
    "aria-hidden": "^1.2.6",
    "attr-accept": "^2.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "detect-node-es": "^1.1.0",
    "file-selector": "^2.1.2",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.16.0",
    "mfront-ui": "workspace:*",
    "object-assign": "^4.1.1",
    "prop-types": "^15.8.1",
    "react-day-picker": "^9.14.0",
    "react-dropzone": "^15.0.0",
    "react-is": "^19.2.6",
    "react-remove-scroll": "^2.7.2",
    "react-remove-scroll-bar": "^2.3.8",
    "react-style-singleton": "^2.2.3",
    "react-toastify": "^11.0.5",
    "reselect": "^5.2.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.1",
    "use-callback-ref": "^1.3.3",
    "use-sidecar": "^1.1.3",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "*",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "author": {
    "name": "Bangla Fighter",
    "url": "https://banglafighter.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/banglafighter/mfront-default-ui"
  },
  "homepage": "https://github.com/banglafighter/mfront-default-ui#readme",
  "bugs": {
    "url": "https://github.com/banglafighter/mfront-default-ui/issues"
  },
  "packageManager": "pnpm@10.28.2",
  "exports": {
    "./style": "./src/mfront-default-style.css",
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./style": "./dist/mfront-default-style.css"
    }
  },
  "keywords": [
    "mfront-default-ui",
    "mfront",
    "mweb",
    "maintainable",
    "react",
    "frontend",
    "framework",
    "router",
    "mapend"
  ]
}
