{
  "name": "mfront-default-ui",
  "version": "0.0.2-alpha.1",
  "description": "mFront UI Default Implementation",
  "scripts": {
    "build": "tsdown",
    "version:alpha": "pnpm version prerelease --preid alpha --no-git-tag-version",
    "version:beta": "pnpm version prerelease --preid beta --no-git-tag-version",
    "version:release": "pnpm version patch --no-git-tag-version",
    "publish:alpha": "pnpm publish --tag alpha --no-git-checks",
    "publish:beta": "pnpm publish --tag beta --no-git-checks",
    "publish:release": "pnpm publish --tag latest --no-git-checks",
    "release:alpha": "pnpm run build && pnpm run version:alpha && pnpm run publish:alpha",
    "release:beta": "pnpm run build && pnpm run version:beta && pnpm run publish:beta",
    "release": "pnpm run build && pnpm run version:release && pnpm run publish:release"
  },
  "dependencies": {
    "mfront-ui": "workspace:*",
    "react-toastify": "^11.0.5",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.5.0",
    "lucide-react": "*",
    "@radix-ui/react-separator": "*",
    "@radix-ui/react-primitive": "*",
    "@radix-ui/react-slot": "*",
    "@radix-ui/react-compose-refs": "*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@base-ui/react": "^1.4.1",
    "tw-animate-css": "^1.4.0",
    "react-dropzone": "^15.0.0",
    "prop-types": "^15.8.1",
    "file-selector": "^2.1.2",
    "attr-accept": "^2.2.5",
    "react-is": "^19.2.6",
    "object-assign": "^4.1.1",
    "react-day-picker": "^9.14.0",
    "date-fns": "^4.1.0",
    "@date-fns/tz": "^1.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "*",
    "tailwindcss": "*"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "author": {
    "name": "Bangla Fighter",
    "url": "https://banglafighter.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/banglafighter/mfront-default-ui"
  },
  "homepage": "https://github.com/banglafighter/mfront-default-ui#readme",
  "bugs": {
    "url": "https://github.com/banglafighter/mfront-default-ui/issues"
  },
  "packageManager": "pnpm@10.28.2",
  "exports": {
    "./style": "./mfront-default-style.css",
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "keywords": [
    "mfront-default-ui",
    "mfront",
    "mweb",
    "maintainable",
    "react",
    "frontend",
    "framework",
    "router",
    "mapend"
  ]
}
